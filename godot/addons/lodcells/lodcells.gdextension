[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

; Bibliothèque copiée depuis target/release/ par tools/build.sh
linux.debug.x86_64 = "res://addons/lodcells/bin/liblodcells_godot.so"
linux.release.x86_64 = "res://addons/lodcells/bin/liblodcells_godot.so"
